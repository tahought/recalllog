# ── データベース接続 ──────────────────────────────────────────────
# Neon（https://neon.tech）で作成した PostgreSQL の接続文字列を貼り付ける。
# 例: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── JWT 署名鍵 ────────────────────────────────────────────────────
# 認証トークンの署名に使う秘密鍵。16文字以上のランダムな文字列に置き換えること。
# 生成例（ターミナル）: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING"
